# CoreDNS L2 - Kubernetes service discovery: kubernetes plugin, stub zones, split-horizon
# Demonstrates: the kubernetes plugin, a real in-cluster Corefile layout
#               (health/ready/loop/reload/forward to the node resolver), and
#               stub zones that send corp/VPC names to internal DNS servers.
#
# This is the shape of the Corefile that kubeadm/EKS/GKE ship, plus two stub zones.
# Tested in CI: ./test-in-kind.sh deploys it as a *second* CoreDNS (namespace
# dns-lab, never touching kube-system) in a kind cluster and resolves
# kubernetes.default.svc.cluster.local through it.
#
# On a real cluster, put it in the `coredns` ConfigMap in kube-system:
#   kubectl -n kube-system create configmap coredns --from-file=Corefile=<this file> --dry-run=client -o yaml | kubectl apply -f -
# CoreDNS reloads it by itself (reload plugin) a minute or two later.
#
# Reference: https://kubernetes.io/docs/tasks/administer-cluster/dns-custom-nameservers/

# ── Stub zone: company internal DNS (split-horizon) ──────────────────────────
# *.corp.example.com goes to the on-prem resolvers instead of the internet, so
# internal names never leak to public DNS.
corp.example.com:53 {
    errors
    forward . 10.10.0.53 10.10.0.54 {
        force_tcp                    # large answers from AD DNS
        health_check 10s
        max_fails 2
        expire 30s
    }
    cache 120
}

# ── Stub zone: cloud private hosted zone ─────────────────────────────────────
# Route 53 private zones only resolve through the VPC resolver (169.254.169.253).
aws.internal:53 {
    errors
    forward . 169.254.169.253 {
        health_check 15s
    }
    cache 60
}

# ── Everything else: cluster names + the node's own resolver ─────────────────
.:53 {
    errors

    # Liveness (:8080/health) and readiness (:8181/ready). They are declared once,
    # here: a second `health` on the same port in another block fails to bind.
    health {
        lameduck 5s
    }
    ready

    # Services, headless SRV records and (insecure) pod A records.
    # `pods insecure` is what upstream ships. `pods verified` makes CoreDNS check
    # that the pod exists, which costs memory on large clusters and is NOT a
    # spoofing defence: any pod can still query any name.
    kubernetes cluster.local in-addr.arpa ip6.arpa {
        pods insecure
        fallthrough in-addr.arpa ip6.arpa
        ttl 30
        # namespaces default production staging     # restrict what is served
    }

    prometheus :9153

    # Non-cluster names: use whatever the node itself uses (VPC DNS, corporate
    # DNS). Forcing a public DoT upstream here would bypass internal DNS.
    forward . /etc/resolv.conf {
        max_concurrent 1000
    }

    cache 30
    loop          # stop if the upstream is this very CoreDNS
    reload        # pick up ConfigMap changes
    loadbalance   # shuffle A/AAAA answers
}
